---
import type { MarkdownHeading } from 'astro'
import { cn } from 'astro-pure/utils'

export interface TocItem extends MarkdownHeading {
  subheadings: TocItem[]
}

interface Props {
  heading: TocItem
}

const {
  heading: { depth, slug, subheadings, text: rawText }
} = Astro.props

const text = rawText.endsWith('#') ? rawText.slice(0, -1) : rawText
---

<li>
  <div class='relative'>
    <span
      data-toc-progress={slug}
      class='absolute top-[5%] w-[2px] rounded transition-colors duration-300'
    ></span>
    <a
      aria-label={`Scroll to section: ${text}`}
      data-toc-link={slug}
      class={cn(
        'toc-item line-clamp-2 px-3 py-1 ms-2 text-foreground/75 transition-all hover:text-foreground',
        depth > 2 && 'ps-7'
      )}
      href={`#${slug}`}>{text}</a
    >
  </div>
  {
    !!subheadings.length && (
      <ul>
        {subheadings.map((subheading) => (
          <Astro.self heading={subheading} />
        ))}
      </ul>
    )
  }
</li>
